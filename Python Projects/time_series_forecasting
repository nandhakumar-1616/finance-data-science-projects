import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error, mean_absolute_error
from statsmodels.tsa.arima.model import ARIMA
import warnings
warnings.filterwarnings('ignore')

class TimeSeriesForecaster:
    def __init__(self, data, test_size=0.2):
        self.data = pd.Series(data) if not isinstance(data, pd.Series) else data
        self.test_size = test_size
        self.scaler = MinMaxScaler()
        self.train_size = int(len(self.data) * (1 - test_size))
        self.train_data = self.data[:self.train_size]
        self.test_data = self.data[self.train_size:]
    
    def moving_average_forecast(self, window=5, periods=10):
        last_values = self.data[-window:].values
        forecast = []
        for _ in range(periods):
            forecast.append(np.mean(last_values))
            last_values = np.append(last_values[1:], forecast[-1])
        return np.array(forecast)
    
    def exponential_smoothing(self, alpha=0.3, periods=10):
        forecast = []
        level = self.data.iloc[0]
        
        for value in self.data[1:]:
            level = alpha * value + (1 - alpha) * level
        
        for _ in range(periods):
            forecast.append(level)
        return np.array(forecast)
    
    def evaluate_model(self, predictions, actual):
        mse = mean_squared_error(actual, predictions[:len(actual)])
        rmse = np.sqrt(mse)
        mae = mean_absolute_error(actual, predictions[:len(actual)])
        return {'MSE': mse, 'RMSE': rmse, 'MAE': mae}
    
    #Baseline Models
    def naive_forecast(self, periods=10):
        last_value = self.data.iloc[-1]
        return np.full(periods, last_value)
    
    def seasonal_naive_forecast(self, season_length=12, periods=10):
        forecast = []
        data_len = len(self.data)
        
        for i in range(periods):
            idx = data_len - season_length + (i % season_length)
            if idx >= 0:
                forecast.append(self.data.iloc[idx])
            else:
                forecast.append(self.data.iloc[-1])
        return np.array(forecast)
    
    def drift_forecast(self, periods=10):
        n = len(self.data)
        drift = (self.data.iloc[-1] - self.data.iloc[0]) / (n - 1)
        last_value = self.data.iloc[-1]
        
        forecast = []
        for i in range(1, periods + 1):
            forecast.append(last_value + drift * i)
        return np.array(forecast)
    
    #ARIMA Model
    def fit_arima(self, order=(1, 1, 1)):
        self.arima_model = ARIMA(self.train_data, order=order)
        self.arima_fitted = self.arima_model.fit()
        return self.arima_fitted
    
    def arima_forecast(self, periods=10):
        if not hasattr(self, 'arima_fitted'):
            raise ValueError("ARIMA model not fitted. Call fit_arima() first.")
        
        forecast_result = self.arima_fitted.get_forecast(steps=periods)
        return forecast_result.predicted_mean.values
    
    def arima_summary(self):
        if not hasattr(self, 'arima_fitted'):
            raise ValueError("ARIMA model not fitted. Call fit_arima() first.")
        return self.arima_fitted.summary()
    
    def compare_baseline_models(self, periods=10):
        results = {}
        test_actual = self.test_data.values[:periods]
        
        naive_pred = self.naive_forecast(periods)
        results['Naive'] = self.evaluate_model(naive_pred, test_actual)
        
        seasonal_pred = self.seasonal_naive_forecast(season_length=12, periods=periods)
        results['Seasonal Naive'] = self.evaluate_model(seasonal_pred, test_actual)
        
        drift_pred = self.drift_forecast(periods)
        results['Drift'] = self.evaluate_model(drift_pred, test_actual)
        
        if hasattr(self, 'arima_fitted'):
            arima_pred = self.arima_forecast(periods)
            results['ARIMA'] = self.evaluate_model(arima_pred, test_actual)
        
        return results
    
    #cross validation
    def time_series_cross_validation(self, arima_order=(1, 1, 1), n_splits=5, forecast_steps=1):
        data_len = len(self.data)
        fold_size = data_len // (n_splits + 1)
        cv_results = {'fold': [], 'mse': [], 'rmse': [], 'mae': []}
        
        for fold in range(n_splits):
            train_end = fold_size * (fold + 1)
            test_start = train_end
            test_end = min(test_start + forecast_steps, data_len)
            
            if test_end <= test_start:
                break
            
            train_fold = self.data[:train_end]
            test_fold = self.data[test_start:test_end]
            
            try:
                model = ARIMA(train_fold, order=arima_order)
                fitted = model.fit()
                
                predictions = fitted.forecast(steps=len(test_fold))
                
                fold_metrics = self.evaluate_model(predictions.values, test_fold.values)
                
                cv_results['fold'].append(fold + 1)
                cv_results['mse'].append(fold_metrics['MSE'])
                cv_results['rmse'].append(fold_metrics['RMSE'])
                cv_results['mae'].append(fold_metrics['MAE'])
                
            except Exception as e:
                print(f"Error in fold {fold + 1}: {str(e)}")
                continue
        
        cv_df = pd.DataFrame(cv_results)
        if len(cv_df) > 0:
            print(f"\nCross-Validation Results ({n_splits} folds):")
            print(f"Average RMSE: {np.mean(cv_results['rmse']):.4f}")
            print(f"Average MAE: {np.mean(cv_results['mae']):.4f}")
        
        return cv_df

    #Exogenous Features
    def fit_arima_with_exogenous(self, exogenous_data, order=(1, 1, 1)):
        if len(exogenous_data) != len(self.train_data):
            raise ValueError("Length of exogenous data must match training data.")
        
        self.arima_exog_model = ARIMA(self.train_data, exog=exogenous_data, order=order)
        self.arima_exog_fitted = self.arima_exog_model.fit()
        return self.arima_exog_fitted
    
    def arima_exogenous_forecast(self, exogenous_forecast, periods=10):
        if not hasattr(self, 'arima_exog_fitted'):
            raise ValueError("ARIMA model with exogenous variables not fitted. Call fit_arima_with_exogenous() first.")
        
        forecast_result = self.arima_exog_fitted.get_forecast(steps=periods, exog=exogenous_forecast)
        return forecast_result.predicted_mean.values
    
    #Prediction Intervals
    def arima_forecast_with_intervals(self, periods=10, alpha=0.05):
        if not hasattr(self, 'arima_fitted'):
            raise ValueError("ARIMA model not fitted. Call fit_arima() first.")
        
        forecast_result = self.arima_fitted.get_forecast(steps=periods)
        forecast_mean = forecast_result.predicted_mean.values
        conf_int = forecast_result.conf_int(alpha=alpha)
        
        return forecast_mean, conf_int

    #Evaluation Metrics
    def plot_forecast(self, forecast, actual=None, title="Forecast vs Actual"):
        plt.figure(figsize=(12, 6))
        plt.plot(self.data.index, self.data.values, label='Historical Data', color='blue')
        forecast_index = range(len(self.data), len(self.data) + len(forecast))
        plt.plot(forecast_index, forecast, label='Forecast', color='orange')
        
        if actual is not None:
            plt.plot(forecast_index[:len(actual)], actual, label='Actual', color='green')
        
        plt.title(title)
        plt.xlabel('Time')
        plt.ylabel('Value')
        plt.legend()
        plt.show()
    
    def plot_residuals(self, residuals):
        plt.figure(figsize=(12, 6))
        plt.plot(residuals, label='Residuals', color='red')
        plt.axhline(0, color='black', linestyle='--')
        plt.title('Residuals of the Forecast')
        plt.xlabel('Time')
        plt.ylabel('Residual Value')
        plt.legend()
        plt.show()

